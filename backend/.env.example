# Node Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/medistock

# JWT Configuration (JWT_SECRET must be at least 32 characters)
JWT_SECRET=replace_this_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=1h

# Frontend Allowed Origin (comma-separated list for multiple origins)
CLIENT_URL=http://localhost:5173

# Initial Admin Credentials (for seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@medistock.com
ADMIN_PASSWORD=AdminPassword123!
